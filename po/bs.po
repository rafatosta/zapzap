#: zapzap/features/settings/pages/performance_experimental/controller.py:144
msgid ""
"Defines where the HTTP cache will be stored.\n"
"Disk: faster after restart.\n"
"Memory: faster, but lost on exit.\n"
"No cache: lower disk usage, slower."
msgstr ""
"Definira gdje će biti pohranjena HTTP keš memorija.\n"
"Disk: brži nakon ponovnog pokretanja.\n"
"Memorija: brža, ali izgubljena pri izlasku.\n"
"Nema keš memorije: manja upotreba diska, sporija."

#: zapzap/features/settings/pages/performance_experimental/controller.py:152
#, fuzzy, python-brace-format
msgid ""
"Maximum HTTP cache size: {maximum} MiB.\n"
"0 MiB uses Chromium's automatic cache management."
msgstr ""
"Maksimalna veličina HTTP keša.\n"
"0 MB koristi zadano ponašanje Chromium."

#: zapzap/features/settings/pages/performance_experimental/controller.py:157
msgid ""
"Keeps cookies between restarts.\n"
"Disabling may cause frequent logouts."
msgstr ""
"Čuva kolačiće između ponovnih pokretanja.\n"
"Onemogućavanje može uzrokovati česte odjave."

#: zapzap/features/settings/pages/performance_experimental/controller.py:161
msgid ""
"Runs GPU and rendering in the same process.\n"
"May reduce memory usage, but can cause instability."
msgstr ""
"Pokreće GPU i renderiranje u istom procesu.\n"
"Može smanjiti upotrebu memorije, ali može uzrokovati nestabilnost."

#: zapzap/features/settings/pages/performance_experimental/controller.py:167
msgid ""
"Disables GPU hardware acceleration.\n"
"Recommended only for old GPUs or problematic drivers."
msgstr ""
"Onemogućuje GPU hardversko ubrzanje.\n"
"Preporučuje se samo za stare GPU-ove ili problematične drajvere."

#: zapzap/features/settings/pages/performance_experimental/controller.py:173
msgid ""
"Automatically honors an unambiguous DRI_PRIME selector on systems with "
"multiple Linux render GPUs. Otherwise, adds --disable-gpu-compositing when "
"one GPU has no connected display.\n"
"\n"
"Disable this only if the automatic workaround causes problems. Restart "
"required."
msgstr ""
"Automatski poštuje nedvosmisleni DRI_PRIME selektor na sistemima s "
"višestrukim Linux GPU-ovima za renderiranje.U suprotnom, dodaje --disable-"
"gpu-compositing kada jedan GPU nema povezan ekran.\n"
"\n"
"Onemogućite ovo samo ako automatsko rješenje uzrokuje probleme.Potrebno je "
"ponovno pokretanje."

#: zapzap/features/settings/pages/performance_experimental/controller.py:182
msgid ""
"Disables GPU VSync.\n"
"May reduce latency, but can increase power usage and tearing."
msgstr ""
"Onemogućuje GPU VSync.\n"
"Može smanjiti kašnjenje, ali može povećati potrošnju energije i kidanje."

#: zapzap/features/settings/pages/performance_experimental/controller.py:188
msgid ""
"Forces software rendering.\n"
"Use only in case of graphical issues.\n"
"May significantly reduce performance."
msgstr ""
"Forsira softversko prikazivanje.\n"
"Koristite samo u slučaju grafičkih problema.\n"
"Može značajno smanjiti performanse."

#: zapzap/features/settings/pages/performance_experimental/controller.py:195
msgid ""
"Disables hardware video decoding without disabling all GPU acceleration.\n"
"Use when videos play only audio, appear white or black, flicker, or cause "
"crashes.\n"
"May increase CPU and battery usage. Restart required."
msgstr ""
"Onemogućava hardversko dekodiranje videa bez isključivanja cjelokupnog GPU "
"ubrzanja.\n"
"Koristite kada videozapisi reproduciraju samo zvuk, budu bijeli ili crni, "
"trepere ili uzrokuju padove.\n"
"Može povećati potrošnju procesora i baterije. Potrebno je ponovno pokretanje."

#: zapzap/features/settings/pages/performance_experimental/controller.py:204
msgid ""
"Forces the GBM backend on Wayland.\n"
"Known to fix severe typing lag on NVIDIA drivers."
msgstr ""
"Forsira pozadinu GBM-a na Wayland.\n"
"Poznato je da popravlja ozbiljno kašnjenje u kucanju na NVIDIA drajverima."

#: zapzap/features/settings/pages/performance_experimental/controller.py:210
msgid ""
"Disables the accessibility bus.\n"
"Known to fix typing lag or CPU spikes in QtWebEngine."
msgstr ""
"Onemogućuje sabirnicu pristupačnosti.\n"
"Poznato da popravlja kašnjenje u kucanju ili CPU skokove u QtWebEngine."

#: zapzap/features/settings/pages/performance_experimental/controller.py:216
msgid ""
"Runs the entire Chromium engine in a single process.\n"
"Reduces memory usage, but may cause crashes.\n"
"Experimental usage."
msgstr ""
"Pokreće cijeli Chromium motor u jednom procesu.\n"
"Smanjuje upotrebu memorije, ali može uzrokovati padove.\n"
"Eksperimentalna upotreba."

#: zapzap/features/settings/pages/performance_experimental/controller.py:223
msgid ""
"Uses a separate process per site.\n"
"Safer and more stable.\n"
"May increase memory usage."
msgstr ""
"Koristi poseban proces po lokaciji.\n"
"Sigurniji i stabilniji.\n"
"Može povećati upotrebu memorije."

#: zapzap/features/settings/pages/performance_experimental/controller.py:230
msgid ""
"JavaScript (V8) memory limit.\n"
"Automatic is the safest option.\n"
"Higher values allow heavier pages.\n"
"\n"
"Restart required."
msgstr ""
"JavaScript (V8) ograničenje memorije.\n"
"Automatski je najsigurnija opcija.\n"
"Više vrijednosti omogućavaju teže stranice.\n"
"\n"
