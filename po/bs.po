msgstr "Odaberite jezik interfejsa koji koristi ZapZap."

#: zapzap/features/initial_setup/view.py:149
#: zapzap/features/settings/pages/language_downloads/view.py:39
msgid "Interface language"
msgstr "Jezik interfejsa"

#: zapzap/features/initial_setup/view.py:150
msgid "The interface language is applied when you finish setup."
msgstr "Jezik interfejsa se primenjuje kada završite sa podešavanjem."

#: zapzap/features/initial_setup/view.py:159
#: zapzap/features/settings/pages/appearance/view.py:64
msgid "Theme"
msgstr "Tema"

#: zapzap/features/initial_setup/view.py:160
#: zapzap/features/settings/pages/appearance/view.py:64
msgid "Choose the visual theme."
msgstr "Odaberite vizuelnu temu."

#: zapzap/features/initial_setup/view.py:164
#: zapzap/features/settings/pages/appearance/view.py:66
msgid "Automatic"
msgstr "Automatski"

#: zapzap/features/initial_setup/view.py:165
#: zapzap/features/settings/pages/appearance/view.py:67
msgid "Light"
msgstr "Svijetla tema"

#: zapzap/features/initial_setup/view.py:166
#: zapzap/features/settings/pages/appearance/view.py:68
msgid "Dark"
msgstr "Tamna tema"

#: zapzap/features/initial_setup/view.py:183
msgid "Notifications and privacy"
msgstr "Obavještenja i privatnost"

#: zapzap/features/initial_setup/view.py:184
msgid ""
"Decide how much message information appears in native notification banners."
msgstr ""
"Odlučite koliko se informacija o poruci pojavljuje u izvornim banerima "
"obavijesti."

#: zapzap/features/initial_setup/view.py:188
#: zapzap/features/settings/pages/notifications/view.py:39
msgid "Desktop notifications"
msgstr "Obavještenja na radnoj površini"

#: zapzap/features/initial_setup/view.py:189
msgid "Choose whether ZapZap may show desktop notifications."
msgstr ""
"Odaberite da li ZapZap može prikazivati obavještenja na radnoj površini."

#: zapzap/features/initial_setup/view.py:194
msgid "Enable notifications"
msgstr "Omogući obavještenja"

#: zapzap/features/initial_setup/view.py:195
msgid ""
"Allow ZapZap to publish native desktop notifications for WhatsApp activity."
msgstr ""
"Dozvolite ZapZap da objavljuje izvorna obavještenja na radnoj površini za "
"aktivnost WhatsApp."

#: zapzap/features/initial_setup/view.py:203
msgid "Notification privacy"
msgstr "Privatnost obavještenja"

#: zapzap/features/initial_setup/view.py:204
msgid "Limit what is visible in notification banners."
msgstr "Ograničite ono što je vidljivo u banerima obavijesti."

#: zapzap/features/initial_setup/view.py:209
msgid "Show contact photo"
msgstr "Prikaži fotografiju kontakta"

#: zapzap/features/initial_setup/view.py:210
msgid "Display the sender avatar when it is available."
msgstr "Prikaži avatar pošiljaoca kada je dostupan."

#: zapzap/features/initial_setup/view.py:213
msgid "Show contact name"
msgstr "Prikaži ime kontakta"

#: zapzap/features/initial_setup/view.py:214
msgid "Display the sender or group name."
msgstr "Prikažite ime pošiljaoca ili grupe."

#: zapzap/features/initial_setup/view.py:217
msgid "Show message preview"
msgstr "Prikaži pregled poruke"

#: zapzap/features/initial_setup/view.py:218
msgid "Display the message text in the notification."
msgstr "Prikažite tekst poruke u obavještenju."

#: zapzap/features/initial_setup/view.py:221
#: zapzap/features/settings/pages/notifications/view.py:59
msgid "Notification sound"
msgstr "Zvuk obavještenja"

#: zapzap/features/initial_setup/view.py:222
#: zapzap/features/settings/pages/notifications/view.py:60
msgid "Let the desktop play its alert sound for new messages."
msgstr "Dozvoli radnoj površini da reproducira zvuk upozorenja za nove poruke."

#: zapzap/features/initial_setup/view.py:242
msgid "Background behavior"
msgstr "Ponašanje u pozadini"

#: zapzap/features/initial_setup/view.py:243
msgid ""
"Choose whether ZapZap should stay available from the tray and start with "
"your session."
msgstr ""
"Odaberite da li ZapZap treba da ostane dostupan na traci i počnite sa "
"sesijom."

#: zapzap/features/initial_setup/view.py:247
#: zapzap/features/settings/pages/appearance/view.py:81
msgid "Tray icon"
msgstr "Ikona u sistemskoj traci"

#: zapzap/features/initial_setup/view.py:248
msgid "Control tray icon visibility and unread counter."
msgstr "Kontrolirajte vidljivost ikone na traci i brojač nepročitanih."

#: zapzap/features/initial_setup/view.py:253
msgid "Enable tray icon"
msgstr "Omogući ikonu u traci"

#: zapzap/features/initial_setup/view.py:254
msgid "Show ZapZap in the system tray."
msgstr "Prikaži ZapZap u sistemskoj paleti."

#: zapzap/features/initial_setup/view.py:257
msgid "Notification counter"
msgstr "Brojač obaveštenja"

#: zapzap/features/initial_setup/view.py:258
msgid "Show unread notifications on the tray icon."
msgstr "Prikaži nepročitana obavještenja na ikoni u traci."

#: zapzap/features/initial_setup/view.py:268
msgid "Window behavior"
msgstr "Ponašanje prozora"

#: zapzap/features/initial_setup/view.py:269
msgid "Configure close behavior."
msgstr "Konfigurirajte ponašanje zatvaranja."

#: zapzap/features/initial_setup/view.py:274
#: zapzap/features/settings/pages/system_startup/view.py:68
msgid "Close behavior"
msgstr "Blisko ponašanje"

#: zapzap/features/initial_setup/view.py:275
#: zapzap/features/settings/pages/system_startup/view.py:70
msgid "Choose whether ZapZap continues in the background or quits."
msgstr "Odaberite da li se ZapZap nastavlja u pozadini ili se prekida."

#: zapzap/features/initial_setup/view.py:281
#: zapzap/features/settings/pages/system_startup/view.py:77
msgid "Continue in the background"
msgstr "Nastavite u pozadini"

#: zapzap/features/initial_setup/view.py:285
#: zapzap/features/settings/pages/system_startup/view.py:81
msgid "Quit ZapZap"
msgstr "Napusti ZapZap"

#: zapzap/features/initial_setup/view.py:289
#: zapzap/features/settings/pages/system_startup/view.py:88
msgid "Confirm before quitting"
msgstr "Potvrdite prije odustajanja"

#: zapzap/features/initial_setup/view.py:290
#: zapzap/features/settings/pages/system_startup/view.py:89
msgid "Ask for confirmation before completely closing ZapZap."
msgstr "Zatražite potvrdu prije potpunog zatvaranja ZapZap."

#: zapzap/features/initial_setup/view.py:301
#: zapzap/features/settings/pages/system_startup/view.py:40
msgid "Startup"
msgstr "Pokretanje"

#: zapzap/features/initial_setup/view.py:302
msgid "Control how ZapZap behaves when your desktop session starts."
msgstr "Kontrolišite kako se ZapZap ponaša kada započne vaša desktop sesija."

#: zapzap/features/initial_setup/view.py:307
#: zapzap/features/settings/pages/system_startup/view.py:45
msgid "Start with the system"
msgstr "Pokreni sa sistemom"

#: zapzap/features/initial_setup/view.py:308
msgid "Create or remove the desktop autostart entry."
msgstr "Kreirajte ili uklonite unos za automatsko pokretanje radne površine."

#: zapzap/features/initial_setup/view.py:311
msgid "Start minimized"
msgstr "Pokreni minimizirano"

#: zapzap/features/initial_setup/view.py:312
msgid "Open ZapZap in the background instead of showing the main window."
msgstr "Otvorite ZapZap u pozadini umjesto da prikazujete glavni prozor."

#: zapzap/features/initial_setup/view.py:325
msgid "Downloads and typing"
msgstr "Preuzimanja i kucanje"

#: zapzap/features/initial_setup/view.py:326
msgid ""
"Choose where files are saved and enable spell checking when dictionaries are "
"available."
msgstr ""
"Odaberite gdje se datoteke spremaju i omogućite provjeru pravopisa kada su "
"rječnici dostupni."

#: zapzap/features/initial_setup/view.py:330
#: zapzap/features/settings/pages/language_downloads/view.py:52
msgid "Downloads"
msgstr "Preuzimanja"

#: zapzap/features/initial_setup/view.py:331
#: zapzap/features/settings/pages/language_downloads/view.py:53
msgid "Choose where downloaded files are saved."
msgstr "Odaberite gdje će preuzeti datoteke pohranjene."

#: zapzap/features/initial_setup/view.py:336
#: zapzap/features/settings/pages/language_downloads/view.py:57
msgid "Download directory"
msgstr "Preuzmite imenik"

#: zapzap/features/initial_setup/view.py:337
msgid "Set a custom folder or keep the current download location."
msgstr ""
"Postavite prilagođeni folder ili zadržite trenutnu lokaciju preuzimanja."

#: zapzap/features/initial_setup/view.py:338
msgid "Choose folder"
msgstr "Odaberite folder"

#: zapzap/features/initial_setup/view.py:348
#: zapzap/features/settings/pages/language_downloads/view.py:73
msgid "Spell checker"
msgstr "Provjera pravopisa"

#: zapzap/features/initial_setup/view.py:349
#: zapzap/features/settings/pages/language_downloads/view.py:74
msgid "Select compiled dictionaries and where ZapZap should look for them."
msgstr "Odaberite sastavljene rječnike i gdje ih ZapZap treba tražiti."

#: zapzap/features/initial_setup/view.py:354
#: zapzap/features/settings/pages/language_downloads/view.py:78
msgid "Enable spell checker"
msgstr "Omogući provjeru pravopisa"

#: zapzap/features/initial_setup/view.py:355
#: zapzap/features/settings/pages/language_downloads/view.py:79
msgid "Use Qt WebEngine spell checking with the selected dictionary."
msgstr "Koristite Qt WebEngine provjeru pravopisa sa odabranim rječnikom."

#: zapzap/features/initial_setup/view.py:358
#: zapzap/features/settings/pages/language_downloads/view.py:82
msgid "Dictionary language"
msgstr "Jezik rječnika"

#: zapzap/features/initial_setup/view.py:359
#: zapzap/features/settings/pages/language_downloads/view.py:83
msgid "Recognizes only compiled dictionaries (.bdic)."
msgstr "Prepoznaje samo sastavljene rječnike (.bdic)."

#: zapzap/features/initial_setup/view.py:373
msgid "Essential permissions"
msgstr "Osnovne dozvole"

#: zapzap/features/initial_setup/view.py:374
msgid ""
"Allow only the WhatsApp Web permissions you want to grant automatically."
msgstr "Dozvolite samo WhatsApp Web dozvole koje želite automatski dodijeliti."

#: zapzap/features/initial_setup/view.py:379
msgid "When an option is unchecked, ZapZap will ask again in each session."
msgstr "Kada je opcija poništena, ZapZap će ponovo pitati u svakoj sesiji."

#: zapzap/features/initial_setup/view.py:385
msgid ""
"Enable only the permissions you want to grant automatically when the page "
"requests them."
msgstr ""
"Omogućite samo dozvole koje želite automatski dodijeliti kada ih stranica "
"zatraži."

#: zapzap/features/initial_setup/view.py:389
#: zapzap/features/settings/pages/permissions/view.py:64
msgid "Microphone"
msgstr "Mikrofon"

#: zapzap/features/initial_setup/view.py:390
#: zapzap/features/settings/pages/permissions/view.py:65
msgid "Automatically allow access to your microphone."
msgstr "Automatski dozvolite pristup vašem mikrofonu."

#: zapzap/features/initial_setup/view.py:393
#: zapzap/features/settings/pages/permissions/view.py:69
msgid "Camera"
msgstr "Kamera"

#: zapzap/features/initial_setup/view.py:394
#: zapzap/features/settings/pages/permissions/view.py:70
msgid "Automatically allow access to your camera."
msgstr "Automatski dozvolite pristup vašoj kameri."

#: zapzap/features/initial_setup/view.py:397
#: zapzap/features/settings/pages/permissions/view.py:74
msgid "Camera and microphone"
msgstr "Kamera i mikrofon"

#: zapzap/features/initial_setup/view.py:398
#: zapzap/features/settings/pages/permissions/view.py:76
msgid "Automatically allow simultaneous access to the camera and microphone."
msgstr "Automatski dozvoli istovremeni pristup kameri i mikrofonu."

#: zapzap/features/initial_setup/view.py:401
#: zapzap/features/settings/pages/permissions/view.py:93
msgid "Screen sharing"
msgstr "Dijeljenje ekrana"

#: zapzap/features/initial_setup/view.py:402
#: zapzap/features/settings/pages/permissions/view.py:94
msgid "Automatically allow sharing of screen contents."
msgstr "Automatski dozvoli dijeljenje sadržaja ekrana."

#: zapzap/features/initial_setup/view.py:405
#: zapzap/features/settings/pages/permissions/view.py:98
msgid "Screen with audio"
msgstr "Ekran sa zvukom"

#: zapzap/features/initial_setup/view.py:406
#: zapzap/features/settings/pages/permissions/view.py:99
msgid "Automatically allow screen sharing with audio."
msgstr "Automatski dozvoli dijeljenje ekrana sa zvukom."

#: zapzap/features/initial_setup/view.py:427
#: zapzap/features/settings/pages/permissions/view.py:130
msgid "Flatpak permissions"
msgstr "Flatpak dozvole"

#: zapzap/features/initial_setup/view.py:428
#: zapzap/features/settings/pages/permissions/view.py:131
msgid ""
"Grant filesystem access if downloads, imports, or dictionaries cannot reach "
"folders outside the sandbox."
msgstr ""
"Odobrite pristup sistemu datoteka ako preuzimanja, uvozi ili rječnici ne "
"mogu doći do foldera izvan sandbox-a."

#: zapzap/features/initial_setup/view.py:434
#: zapzap/features/settings/pages/permissions/view.py:135
msgid ""
"Flatpak sandbox: if file access fails, grant folder permissions using "
"Flatseal or flatpak override."
msgstr ""
"Flatpak sandbox: ako pristup fajlu ne uspije, dodijelite dozvole foldera "
"koristeći Flatseal ili Flatseal zaobilaženje."

#: zapzap/features/initial_setup/view.py:444
#: zapzap/features/settings/pages/permissions/view.py:143
msgid "Select and copy this command in your terminal"
msgstr "Odaberite i kopirajte ovu naredbu u svoj terminal"

#: zapzap/features/initial_setup/view.py:446
#: zapzap/features/settings/pages/debugging/controller.py:87
#: zapzap/features/settings/pages/debugging/view.py:223
#: zapzap/features/settings/pages/permissions/view.py:145
#: zapzap/features/browser/web/web_view.py:312
msgid "Copy"
msgstr "Kopiraj"

#: zapzap/features/initial_setup/view.py:450
#: zapzap/features/settings/pages/permissions/view.py:149
msgid "Flatseal"
msgstr "Flatseal"

#: zapzap/features/initial_setup/view.py:451
#: zapzap/features/settings/pages/permissions/view.py:150
msgid ""
"Flatseal is a graphical utility to review and modify permissions from your "
"Flatpak applications."
