#: zapzap/features/initial_setup/view.py:183
msgid "Notifications and privacy"
msgstr "Powiadomienia i prywatność"

#: zapzap/features/initial_setup/view.py:184
msgid ""
"Decide how much message information appears in native notification banners."
msgstr ""
"Zdecyduj, ile informacji o wiadomości pojawia się w natywnych "
"powiadomieniach."

#: zapzap/features/initial_setup/view.py:188
#: zapzap/features/settings/pages/notifications/view.py:39
msgid "Desktop notifications"
msgstr "Powiadomienia na pulpicie"

#: zapzap/features/initial_setup/view.py:189
msgid "Choose whether ZapZap may show desktop notifications."
msgstr "Wybierz, czy ZapZap może wyświetlać powiadomienia na pulpicie."

#: zapzap/features/initial_setup/view.py:194
msgid "Enable notifications"
msgstr "Włącz powiadomienia"

#: zapzap/features/initial_setup/view.py:195
msgid ""
"Allow ZapZap to publish native desktop notifications for WhatsApp activity."
msgstr ""
"Zezwól ZapZap na publikowanie natywnych powiadomień pulpitowych o aktywności "
"WhatsApp."

#: zapzap/features/initial_setup/view.py:203
msgid "Notification privacy"
msgstr "Prywatność powiadomień"

#: zapzap/features/initial_setup/view.py:204
msgid "Limit what is visible in notification banners."
msgstr "Ogranicz to, co jest widoczne w banerach powiadomień."

#: zapzap/features/initial_setup/view.py:209
msgid "Show contact photo"
msgstr "Pokaż zdjęcie kontaktu"

#: zapzap/features/initial_setup/view.py:210
