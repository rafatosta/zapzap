msgstr "Підтверджувати перед виходом"

#: zapzap/features/settings/pages/system_startup/view.py:89
msgid "Ask for confirmation before completely closing ZapZap."
msgstr "Запитати підтвердження перед повним закриттям ZapZap."

#: zapzap/features/settings/pages/system_startup/view.py:96
msgid ""
"Choose whether ZapZap continues in the background or quits when the window "
"is closed."
msgstr ""
"Виберіть, чи ZapZap продовжує працювати у фоновому режимі або закривається "
"при закритті вікна."

#: zapzap/features/settings/pages/system_startup/view.py:110
msgid "Linux integration"
msgstr "Інтеграція з Linux"

#: zapzap/features/settings/pages/system_startup/view.py:111
msgid "Settings related to the desktop environment and platform."
msgstr "Налаштування, пов'язані з робочим середовищем та платформою."

#: zapzap/features/settings/pages/system_startup/view.py:115
msgid "System file dialogs"
msgstr "Системні діалоги файлів"

#: zapzap/features/settings/pages/system_startup/view.py:116
msgid "Use the file picker provided by the desktop environment."
msgstr "Використовуйте вибір файлів, наданий робочим середовищем."

#: zapzap/features/settings/pages/system_startup/view.py:128
msgid "Run natively on Wayland"
msgstr "Запускати нативно на Wayland"

#: zapzap/features/settings/pages/system_startup/view.py:129
msgid "Use the Wayland backend when available."
msgstr "Використовувати бекенд Wayland, коли доступно."

#: zapzap/features/settings/pages/system_startup/view.py:135
msgid "Use the Wayland backend when available. Requires restart."
msgstr ""
"Використовуйте бекенд Wayland, коли він доступний. Потрібне перезавантаження."

#: zapzap/features/settings/pages/system_startup/view.py:139
msgid "Requires restart"
msgstr "Потребує перезапуску"

#: zapzap/features/settings/pages/system_startup/view.py:143
msgid "Wayland changes require restart"
msgstr "Зміни Wayland потребують перезавантаження"

