msgid "Automatically allow simultaneous access to the camera and microphone."
msgstr "Автоматично дозволяти одночасний доступ до камери та мікрофона."

#: zapzap/features/settings/pages/permissions/view.py:82
msgid "Location"
msgstr "Розташування"

#: zapzap/features/settings/pages/permissions/view.py:83
msgid "Automatically allow access to your location."
msgstr "Автоматично дозволяти доступ до вашого місцезнаходження."

#: zapzap/features/settings/pages/permissions/view.py:89
msgid "Sharing"
msgstr "Спільний доступ"

#: zapzap/features/settings/pages/permissions/view.py:93
msgid "Screen sharing"
msgstr "Спільний доступ до екрана"

#: zapzap/features/settings/pages/permissions/view.py:98
msgid "Screen with audio"
msgstr "Екран з аудіо"

#: zapzap/features/settings/pages/permissions/view.py:99
msgid "Automatically allow screen sharing with audio."
msgstr "Автоматично дозволяти демонстрацію екрану з аудіо."

#: zapzap/features/settings/pages/permissions/view.py:105
msgid "Advanced"
msgstr "Розширені"

#: zapzap/features/settings/pages/permissions/view.py:109
msgid "Pointer lock"
msgstr "Блокування вказівника"

#: zapzap/features/settings/pages/permissions/view.py:110
