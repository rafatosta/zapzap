msgid "Show ZapZap in the system tray."
msgstr "A(z) ZapZap megjelenítése a tálcán."

#: zapzap/features/initial_setup/view.py:257
msgid "Notification counter"
msgstr "Értesítési számláló"

#: zapzap/features/initial_setup/view.py:258
msgid "Show unread notifications on the tray icon."
msgstr "Az olvasatlan értesítések megjelenítése a tálcaikonon."

#: zapzap/features/initial_setup/view.py:268
msgid "Window behavior"
msgstr "Az ablak viselkedése"

#: zapzap/features/initial_setup/view.py:269
msgid "Configure close behavior."
msgstr "Bezárási viselkedés konfigurálása."

#: zapzap/features/initial_setup/view.py:274
#: zapzap/features/settings/pages/system_startup/view.py:68
msgid "Close behavior"
msgstr "Zárt viselkedés"

#: zapzap/features/initial_setup/view.py:275
#: zapzap/features/settings/pages/system_startup/view.py:70
msgid "Choose whether ZapZap continues in the background or quits."
msgstr "Válassza ki, hogy a ZapZap a háttérben folytatódik, vagy kilép."

#: zapzap/features/initial_setup/view.py:281
#: zapzap/features/settings/pages/system_startup/view.py:77
msgid "Continue in the background"
msgstr "Folytassa a háttérben"

#: zapzap/features/initial_setup/view.py:285
#: zapzap/features/settings/pages/system_startup/view.py:81
msgid "Quit ZapZap"
msgstr "Kilépés ZapZap"

#: zapzap/features/initial_setup/view.py:289
#: zapzap/features/settings/pages/system_startup/view.py:88
msgid "Confirm before quitting"
msgstr "Erősítse meg a kilépés előtt"

#: zapzap/features/initial_setup/view.py:290
#: zapzap/features/settings/pages/system_startup/view.py:89
msgid "Ask for confirmation before completely closing ZapZap."
msgstr "Kérjen megerősítést a(z) ZapZap teljes bezárása előtt."

#: zapzap/features/initial_setup/view.py:301
#: zapzap/features/settings/pages/system_startup/view.py:40
msgid "Startup"
msgstr "Indítás"

#: zapzap/features/initial_setup/view.py:302
msgid "Control how ZapZap behaves when your desktop session starts."
msgstr ""
"Szabályozza, hogy a ZapZap hogyan viselkedjen az asztali munkamenet "
"indításakor."

#: zapzap/features/initial_setup/view.py:307
#: zapzap/features/settings/pages/system_startup/view.py:45
msgid "Start with the system"
msgstr "Rendszerindításkor indul"

#: zapzap/features/initial_setup/view.py:308
msgid "Create or remove the desktop autostart entry."
msgstr ""
"Hozza létre vagy távolítsa el az asztali automatikus indítás bejegyzést."

#: zapzap/features/initial_setup/view.py:311
msgid "Start minimized"
msgstr "Minimalizált indítás"

#: zapzap/features/initial_setup/view.py:312
msgid "Open ZapZap in the background instead of showing the main window."
msgstr ""
"Nyissa meg a ZapZap elemet a háttérben a főablak megjelenítése helyett."

#: zapzap/features/initial_setup/view.py:325
msgid "Downloads and typing"
msgstr "Letöltések és gépelés"

#: zapzap/features/initial_setup/view.py:326
msgid ""
"Choose where files are saved and enable spell checking when dictionaries are "
"available."
msgstr ""
"Válassza ki a fájlok mentési helyét, és engedélyezze a helyesírás-"
"ellenőrzést, ha szótárak állnak rendelkezésre."

#: zapzap/features/initial_setup/view.py:330
#: zapzap/features/settings/pages/language_downloads/view.py:53
msgid "Downloads"
msgstr "Letöltések"

#: zapzap/features/initial_setup/view.py:331
#: zapzap/features/settings/pages/language_downloads/view.py:54
msgid "Choose where downloaded files are saved."
msgstr "Válassza ki a letöltött fájlok mentési helyét."

#: zapzap/features/initial_setup/view.py:336
#: zapzap/features/settings/pages/language_downloads/view.py:58
msgid "Download directory"
msgstr "Könyvtár letöltése"

#: zapzap/features/initial_setup/view.py:337
msgid "Set a custom folder or keep the current download location."
msgstr ""
"Állítson be egyéni mappát, vagy tartsa meg az aktuális letöltési helyet."

#: zapzap/features/initial_setup/view.py:338
msgid "Choose folder"
msgstr "Válasszon mappát"

#: zapzap/features/initial_setup/view.py:348
#: zapzap/features/settings/pages/language_downloads/view.py:74
msgid "Spell checker"
msgstr "Helyesírás-ellenőrző"

#: zapzap/features/initial_setup/view.py:349
#: zapzap/features/settings/pages/language_downloads/view.py:75
msgid "Select compiled dictionaries and where ZapZap should look for them."
msgstr ""
"Válassza ki az összeállított szótárakat, és azt, hogy a ZapZap hol keresse "
"azokat."

#: zapzap/features/initial_setup/view.py:354
#: zapzap/features/settings/pages/language_downloads/view.py:79
msgid "Enable spell checker"
msgstr "Helyesírás-ellenőrző engedélyezése"

#: zapzap/features/initial_setup/view.py:355
#: zapzap/features/settings/pages/language_downloads/view.py:80
msgid "Use Qt WebEngine spell checking with the selected dictionary."
msgstr ""
"Használja a Qt WebEngine helyesírás-ellenőrzést a kiválasztott szótárral."

#: zapzap/features/initial_setup/view.py:358
msgid "Dictionary language"
msgstr "A szótár nyelve"

