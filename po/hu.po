msgid "Show contact name"
msgstr "Kapcsolattartó nevének megjelenítése"

#: zapzap/features/initial_setup/view.py:214
msgid "Display the sender or group name."
msgstr "Jelenítse meg a feladó vagy a csoport nevét."

#: zapzap/features/initial_setup/view.py:217
msgid "Show message preview"
msgstr "Mutasd az özenet előnézetét"

#: zapzap/features/initial_setup/view.py:218
msgid "Display the message text in the notification."
msgstr "Jelenítse meg az üzenet szövegét az értesítésben."

#: zapzap/features/initial_setup/view.py:221
#: zapzap/features/settings/pages/notifications/view.py:59
msgid "Notification sound"
msgstr "Értesítési hang"

#: zapzap/features/initial_setup/view.py:222
#: zapzap/features/settings/pages/notifications/view.py:60
msgid "Let the desktop play its alert sound for new messages."
msgstr ""
"Az asztali környezet játsszon le figyelmeztető hangot új üzenetek "
"érkezésekor."

#: zapzap/features/initial_setup/view.py:242
msgid "Background behavior"
msgstr "Háttérbeli viselkedés"

#: zapzap/features/initial_setup/view.py:243
msgid ""
"Choose whether ZapZap should stay available from the tray and start with "
"your session."
msgstr ""
"Válassza ki, hogy a ZapZap elérhető maradjon-e a tálcáról, és kezdje el a "
"munkamenetet."

