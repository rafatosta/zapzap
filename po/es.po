msgid "Set a custom folder or keep the current download location."
msgstr ""
"Configure una carpeta personalizada o mantenga la ubicación de descarga "
"actual."

#: zapzap/features/initial_setup/view.py:316
msgid "Choose folder"
msgstr "Elige carpeta"

#: zapzap/features/initial_setup/view.py:326
#: zapzap/features/settings/pages/language_downloads/view.py:73
msgid "Spell checker"
msgstr "corrector ortográfico"

#: zapzap/features/initial_setup/view.py:327
#: zapzap/features/settings/pages/language_downloads/view.py:74
msgid "Select compiled dictionaries and where ZapZap should look for them."
msgstr "Seleccione diccionarios compilados y dónde debe buscarlos ZapZap."

#: zapzap/features/initial_setup/view.py:332
#: zapzap/features/settings/pages/language_downloads/view.py:78
msgid "Enable spell checker"
msgstr "Habilitar corrector ortográfico"

#: zapzap/features/initial_setup/view.py:333
#: zapzap/features/settings/pages/language_downloads/view.py:79
msgid "Use Qt WebEngine spell checking with the selected dictionary."
msgstr ""
"Utilice la revisión ortográfica Qt WebEngine con el diccionario seleccionado."

#: zapzap/features/initial_setup/view.py:336
#: zapzap/features/settings/pages/language_downloads/view.py:82
msgid "Dictionary language"
msgstr "Idioma del diccionario"

#: zapzap/features/initial_setup/view.py:337
#: zapzap/features/settings/pages/language_downloads/view.py:83
msgid "Recognizes only compiled dictionaries (.bdic)."
msgstr "Sólo reconoce diccionarios compilados (.bdic)."

#: zapzap/features/initial_setup/view.py:341
msgid ""
"No compiled dictionaries were found. You can configure dictionaries later in "
"Settings."
msgstr ""
"No se encontraron diccionarios compilados.Puede configurar diccionarios más "
"adelante en Configuración."

#: zapzap/features/initial_setup/view.py:356
msgid "Essential permissions"
msgstr "Permisos esenciales"

#: zapzap/features/initial_setup/view.py:357
msgid ""
"Allow only the WhatsApp Web permissions you want to grant automatically."
msgstr ""
"Permita solo los permisos WhatsApp Web que desee otorgar automáticamente."

#: zapzap/features/initial_setup/view.py:362
msgid "When an option is unchecked, ZapZap will ask again in each session."
msgstr ""
"Cuando una opción no está marcada, ZapZap volverá a preguntar en cada sesión."

#: zapzap/features/initial_setup/view.py:368
msgid ""
"Enable only the permissions you want to grant automatically when the page "
"requests them."
msgstr ""
"Habilite solo los permisos que desee otorgar automáticamente cuando la "
"página los solicite."

#: zapzap/features/initial_setup/view.py:372
#: zapzap/features/settings/pages/permissions/view.py:64
msgid "Microphone"
msgstr "micrófono"

#: zapzap/features/initial_setup/view.py:373
#: zapzap/features/settings/pages/permissions/view.py:65
msgid "Automatically allow access to your microphone."
msgstr "Permita automáticamente el acceso a su micrófono."

#: zapzap/features/initial_setup/view.py:376
#: zapzap/features/settings/pages/permissions/view.py:69
msgid "Camera"
msgstr "cámara"

#: zapzap/features/initial_setup/view.py:377
#: zapzap/features/settings/pages/permissions/view.py:70
msgid "Automatically allow access to your camera."
msgstr "Permita automáticamente el acceso a su cámara."

#: zapzap/features/initial_setup/view.py:380
msgid "Screen contents"
msgstr "Contenidos de la pantalla"

#: zapzap/features/initial_setup/view.py:381
#: zapzap/features/settings/pages/permissions/view.py:94
msgid "Automatically allow sharing of screen contents."
msgstr "Permitir automáticamente compartir contenidos de la pantalla."

#: zapzap/features/initial_setup/view.py:384
msgid "WebRTC shield"
msgstr "escudo WebRTC"

#: zapzap/features/initial_setup/view.py:385
msgid "Reduce WebRTC IP exposure."
msgstr "Reducir la exposición de propiedad intelectual WebRTC."

#: zapzap/features/initial_setup/view.py:402
#: zapzap/features/settings/pages/permissions/view.py:130
msgid "Flatpak permissions"
msgstr "permisos Flatpak"

#: zapzap/features/initial_setup/view.py:403
#: zapzap/features/settings/pages/permissions/view.py:131
msgid ""
"Grant filesystem access if downloads, imports, or dictionaries cannot reach "
"folders outside the sandbox."
msgstr ""
"Otorgue acceso al sistema de archivos si las descargas, importaciones o "
"diccionarios no pueden llegar a carpetas fuera del entorno limitado."

#: zapzap/features/initial_setup/view.py:409
#: zapzap/features/settings/pages/permissions/view.py:135
msgid ""
"Flatpak sandbox: if file access fails, grant folder permissions using "
"Flatseal or flatpak override."
msgstr ""
"Flatpak sandbox: si falla el acceso a los archivos, otorgue permisos de "
"carpeta usando Flatseal o la anulación de flatpak."

#: zapzap/features/initial_setup/view.py:419
#: zapzap/features/settings/pages/permissions/view.py:143
msgid "Select and copy this command in your terminal"
msgstr "Selecciona y copia este comando en tu terminal"

#: zapzap/features/initial_setup/view.py:421
#: zapzap/features/settings/pages/debugging/controller.py:87
#: zapzap/features/settings/pages/debugging/view.py:223
#: zapzap/features/settings/pages/permissions/view.py:145
#: zapzap/features/browser/web/web_view.py:312
msgid "Copy"
msgstr "Copiar"

#: zapzap/features/initial_setup/view.py:425
#: zapzap/features/settings/pages/permissions/view.py:149
msgid "Flatseal"
msgstr "Sello plano"

#: zapzap/features/initial_setup/view.py:426
#: zapzap/features/settings/pages/permissions/view.py:150
msgid ""
"Flatseal is a graphical utility to review and modify permissions from your "
"Flatpak applications."
msgstr ""
"Flatseal es una utilidad gráfica para revisar y modificar permisos de sus "
"aplicaciones Flatpak."

#: zapzap/features/initial_setup/view.py:427
#: zapzap/features/settings/pages/permissions/view.py:151
msgid "Install Flatseal on Linux | Flathub"
msgstr "Instale Flatseal en Linux |Cubo plano"

#: zapzap/features/initial_setup/view.py:442
msgid "You're ready"
msgstr "estas listo"

#: zapzap/features/initial_setup/view.py:443
msgid ""
"ZapZap will save these preferences now. Advanced options remain available in "
"Settings."
msgstr ""
"ZapZap guardará estas preferencias ahora.Las opciones avanzadas permanecen "
"disponibles en Configuración."

#: zapzap/features/initial_setup/view.py:447
msgid "Finish setup"
msgstr "Finalizar la configuración"

#: zapzap/features/initial_setup/view.py:448
msgid "Review advanced options later whenever you need them."
msgstr "Revise las opciones avanzadas más tarde cuando las necesite."

#: zapzap/features/initial_setup/view.py:454
msgid ""
"You can revisit all choices from Settings at any time. Proxy, custom CSS/"
"JavaScript, Flatpak permissions, and performance tweaks are still available "
"there."
msgstr ""
"Puede volver a visitar todas las opciones desde Configuración en cualquier "
"momento.El proxy, los permisos personalizados CSS/JavaScript, Flatpak y los "
"ajustes de rendimiento todavía están disponibles allí."

