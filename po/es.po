msgstr "La aplicación encontró un error inesperado."

#: zapzap/core/diagnostics/dialog_dump_handler.py:30
#, python-brace-format
msgid ""
"A diagnostic report was generated automatically at:\n"
"\n"
"{path}\n"
"\n"
"Please send this file to support so we can investigate the issue.\n"
"\n"
"Report channels:\n"
" - Issue tracker: {issue_url}\n"
" - Email: {email}"
msgstr ""
"Se generó un informe de diagnóstico automáticamente en:\n"
"\n"
"{path}\n"
"\n"
"Envíe este archivo al soporte para que podamos investigar el problema.\n"
"\n"
"Canales de denuncia:\n"
"- Rastreador de problemas: {issue_url}\n"
"- Correo electrónico: {email}"

