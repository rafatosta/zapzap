#: zapzap/features/settings/pages/performance_experimental/view.py:194
msgid "Background throttling"
msgstr "Limitación de fondo"

#: zapzap/features/settings/pages/performance_experimental/view.py:195
msgid "Allows background tabs to reduce resource usage."
msgstr "Permite pestañas en segundo plano para reducir el uso de recursos."

#: zapzap/features/settings/pages/performance_experimental/view.py:198
msgid "Disable animations"
msgstr "Deshabilitar animaciones"

#: zapzap/features/settings/pages/performance_experimental/view.py:199
msgid "May improve performance on slower machines."
msgstr "Puede mejorar el rendimiento en máquinas más lentas."

#: zapzap/features/settings/pages/performance_experimental/view.py:202
