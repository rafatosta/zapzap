#: zapzap/features/settings/pages/performance_experimental/view.py:236
msgid "Restore performance defaults"
msgstr "Restaurar los valores predeterminados de rendimiento"

#: zapzap/features/settings/pages/performance_experimental/view.py:237
msgid "Restores all performance settings to safe default values."
msgstr ""
"Restaura todas las configuraciones de rendimiento a valores predeterminados "
"seguros."

#: zapzap/features/settings/pages/performance_experimental/controller.py:138
msgid ""
"Defines where the HTTP cache will be stored.\n"
"Disk: faster after restart.\n"
"Memory: faster, but lost on exit.\n"
"No cache: lower disk usage, slower."
msgstr ""
"Define dónde se almacenará la caché HTTP.\n"
"Disco: más rápido después del reinicio.\n"
"Memoria: más rápida, pero se pierde al salir.\n"
"Sin caché: menor uso del disco, más lento."

#: zapzap/features/settings/pages/performance_experimental/controller.py:145
msgid ""
"Maximum HTTP cache size.\n"
"0 MB uses the default Chromium behavior."
msgstr ""
"Tamaño máximo de caché HTTP.\n"
"0 MB utiliza el comportamiento predeterminado Chromium."

#: zapzap/features/settings/pages/performance_experimental/controller.py:148
msgid ""
"Keeps cookies between restarts.\n"
"Disabling may cause frequent logouts."
msgstr ""
"Mantiene las cookies entre reinicios.\n"
"La desactivación puede provocar cierres de sesión frecuentes."

#: zapzap/features/settings/pages/performance_experimental/controller.py:152
msgid ""
"Runs GPU and rendering in the same process.\n"
"May reduce memory usage, but can cause instability."
msgstr ""
"Ejecuta GPU y renderiza en el mismo proceso.\n"
"Puede reducir el uso de memoria, pero puede causar inestabilidad."

#: zapzap/features/settings/pages/performance_experimental/controller.py:158
msgid ""
"Disables GPU hardware acceleration.\n"
"Recommended only for old GPUs or problematic drivers."
msgstr ""
"Deshabilita la aceleración de hardware GPU.\n"
"Recomendado sólo para GPU antiguas o controladores problemáticos."

#: zapzap/features/settings/pages/performance_experimental/controller.py:164
msgid ""
"Automatically honors an unambiguous DRI_PRIME selector on systems with "
"multiple Linux render GPUs. Otherwise, adds --disable-gpu-compositing when "
"one GPU has no connected display.\n"
"\n"
"Disable this only if the automatic workaround causes problems. Restart "
"required."
msgstr ""
"Respeta automáticamente un selector DRI_PRIME inequívoco en sistemas con "
"múltiples GPU de renderizado de Linux.De lo contrario, agrega --disable-gpu-"
"compositing cuando un GPU no tiene una pantalla conectada.\n"
"\n"
"Desactívelo sólo si la solución automática causa problemas.Se requiere "
"reinicio."

#: zapzap/features/settings/pages/performance_experimental/controller.py:173
msgid ""
"Disables GPU VSync.\n"
"May reduce latency, but can increase power usage and tearing."
msgstr ""
"Desactiva GPU VSync.\n"
"Puede reducir la latencia, pero puede aumentar el uso de energía y el "
"desgarro."

#: zapzap/features/settings/pages/performance_experimental/controller.py:179
msgid ""
"Forces software rendering.\n"
"Use only in case of graphical issues.\n"
"May significantly reduce performance."
msgstr ""
"Fuerza la renderización del software.\n"
"Úselo solo en caso de problemas gráficos.\n"
"Puede reducir significativamente el rendimiento."

#: zapzap/features/settings/pages/performance_experimental/controller.py:186
msgid ""
"Forces the GBM backend on Wayland.\n"
"Known to fix severe typing lag on NVIDIA drivers."
msgstr ""
"Fuerza el backend de GBM en Wayland.\n"
"Conocido por solucionar graves retrasos de escritura en los controladores "
"NVIDIA."

#: zapzap/features/settings/pages/performance_experimental/controller.py:192
msgid ""
"Disables the accessibility bus.\n"
"Known to fix typing lag or CPU spikes in QtWebEngine."
msgstr ""
"Desactiva el bus de accesibilidad.\n"
"Conocido por corregir retrasos de escritura o picos de CPU en QtWebEngine."

#: zapzap/features/settings/pages/performance_experimental/controller.py:198
msgid ""
"Runs the entire Chromium engine in a single process.\n"
"Reduces memory usage, but may cause crashes.\n"
"Experimental usage."
msgstr ""
"Ejecuta todo el motor Chromium en un solo proceso.\n"
"Reduce el uso de memoria, pero puede provocar fallos.\n"
"Uso experimental."

#: zapzap/features/settings/pages/performance_experimental/controller.py:205
msgid ""
"Uses a separate process per site.\n"
"Safer and more stable.\n"
"May increase memory usage."
msgstr ""
"Utiliza un proceso separado por sitio.\n"
"Más seguro y estable.\n"
"Puede aumentar el uso de memoria."

#: zapzap/features/settings/pages/performance_experimental/controller.py:212
msgid ""
"JavaScript (V8) memory limit.\n"
"Automatic is the safest option.\n"
"Higher values allow heavier pages.\n"
"\n"
"Restart required."
msgstr ""
"JavaScript (V8) límite de memoria.\n"
"Automático es la opción más segura.\n"
"Los valores más altos permiten páginas más pesadas.\n"
"\n"
"Se requiere reinicio."

#: zapzap/features/settings/pages/performance_experimental/controller.py:220
msgid ""
"Enables V8 predictable garbage collection schedule.\n"
"This adds --js-flags=--predictable-gc-schedule and --disable-gpu to "
"QTWEBENGINE_CHROMIUM_FLAGS.\n"
"\n"
"Experimental option. Restart required."
msgstr ""
"Habilita el programa de recolección de basura predecible de V8.\n"
"Esto agrega --js-flags=--predictable-gc-schedule y --disable-gpu a "
"QTWEBENGINE_CHROMIUM_FLAGS.\n"
"\n"
"Opción experimental.Se requiere reinicio."

#: zapzap/features/settings/pages/performance_experimental/controller.py:227
msgid ""
"Enables smooth scrolling animations.\n"
"Disabling may reduce CPU usage."
msgstr ""
"Permite animaciones de desplazamiento suave.\n"
"Deshabilitarlo puede reducir el uso de la CPU."

#: zapzap/features/settings/pages/performance_experimental/controller.py:231
msgid ""
"Allows background tabs to reduce resource usage.\n"
"Disabling keeps timers active, but uses more resources."
msgstr ""
"Permite pestañas en segundo plano para reducir el uso de recursos.\n"
"La desactivación mantiene los temporizadores activos, pero utiliza más "
"recursos."

#: zapzap/features/settings/pages/performance_experimental/controller.py:237
msgid ""
"Disables CSS and JavaScript animations.\n"
"May improve performance on slower machines."
msgstr ""
"Deshabilita las animaciones CSS y JavaScript.\n"
"Puede mejorar el rendimiento en máquinas más lentas."

#: zapzap/features/settings/pages/performance_experimental/controller.py:243
msgid ""
"Disables pinch-to-zoom gesture on touchpads.\n"
"Useful if accidental zooming occurs during scrolling."
msgstr ""
"Desactiva el gesto de pellizcar para hacer zoom en los paneles táctiles.\n"
"Útil si se produce un zoom accidental durante el desplazamiento."

#: zapzap/features/settings/pages/performance_experimental/controller.py:249
msgid ""
"Uses Selection.modify() with visual directions for Ctrl+Arrow word "
"navigation.\n"
"This fixes reversed cursor movement in RTL text inside WhatsApp Web message "
"fields.\n"
"\n"
"Restart or reload WhatsApp Web after changing this option."
msgstr ""
"Utiliza Selection.modify() con instrucciones visuales para la navegación de "
"palabras Ctrl+Arrow.\n"
"Esto corrige el movimiento invertido del cursor en el texto RTL dentro de "
"los campos de mensaje WhatsApp Web.\n"
"\n"
"Reinicie o vuelva a cargar WhatsApp Web después de cambiar esta opción."

#: zapzap/features/settings/pages/performance_experimental/controller.py:255
msgid ""
"Restores all performance settings\n"
"to safe default values."
msgstr ""
"Restaura todas las configuraciones de rendimiento\n"
"a valores predeterminados seguros."

