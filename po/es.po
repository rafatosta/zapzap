msgid "Hide the main window instead of quitting when it is closed."
msgstr "Oculte la ventana principal en lugar de salir cuando esté cerrada."

#: zapzap/features/initial_setup/view.py:268
msgid "Confirm before closing the window"
msgstr "Confirmar antes de cerrar la ventana"

#: zapzap/features/initial_setup/view.py:269
msgid "Ask for confirmation before closing ZapZap."
msgstr "Solicite confirmación antes de cerrar ZapZap."

#: zapzap/features/initial_setup/view.py:279
#: zapzap/features/settings/pages/system_startup/view.py:40
msgid "Startup"
msgstr "Inicio"

#: zapzap/features/initial_setup/view.py:280
msgid "Control how ZapZap behaves when your desktop session starts."
msgstr ""
"Controle cómo se comporta ZapZap cuando se inicia su sesión de escritorio."

#: zapzap/features/initial_setup/view.py:285
#: zapzap/features/settings/pages/system_startup/view.py:45
msgid "Start with the system"
msgstr "Iniciar con el sistema"

#: zapzap/features/initial_setup/view.py:286
msgid "Create or remove the desktop autostart entry."
msgstr "Cree o elimine la entrada de inicio automático del escritorio."

#: zapzap/features/initial_setup/view.py:289
msgid "Start minimized"
msgstr "Iniciar minimizado"

#: zapzap/features/initial_setup/view.py:290
msgid "Open ZapZap in the background instead of showing the main window."
msgstr "Abra ZapZap en segundo plano en lugar de mostrar la ventana principal."

