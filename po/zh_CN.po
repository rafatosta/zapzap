#: zapzap/features/settings/pages/performance_experimental/view.py:148
msgid "May reduce latency, but can increase tearing."
msgstr "可能降低延迟，但可能增加画面撕裂。"

#: zapzap/features/settings/pages/performance_experimental/view.py:151
msgid "Force software rendering"
msgstr "强制软件渲染"

#: zapzap/features/settings/pages/performance_experimental/view.py:152
msgid "Use only for graphical issues."
