msgstr "חזרה"

#: zapzap/features/initial_setup/view.py:119
msgid "Next"
msgstr "הבא"

#: zapzap/features/initial_setup/view.py:137
msgid "Language and appearance"
msgstr "שפה ומראה"

#: zapzap/features/initial_setup/view.py:138
msgid "Start with the interface language and a comfortable visual theme."
msgstr "התחל עם שפת הממשק ונושא ויזואלי נוח."

#: zapzap/features/initial_setup/view.py:143
#: zapzap/features/settings/pages/language_downloads/view.py:34
msgid "Language"
msgstr "שפה"

#: zapzap/features/initial_setup/view.py:144
#: zapzap/features/settings/pages/language_downloads/view.py:35
msgid "Choose the interface language used by ZapZap."
msgstr "בחר את שפת הממשק שבה משתמש ZapZap."

#: zapzap/features/initial_setup/view.py:149
#: zapzap/features/settings/pages/language_downloads/view.py:39
msgid "Interface language"
msgstr "שפת ממשק"

#: zapzap/features/initial_setup/view.py:150
msgid "The interface language is applied when you finish setup."
msgstr "שפת הממשק מוחלת כאשר אתה מסיים את ההגדרה."

#: zapzap/features/initial_setup/view.py:159
#: zapzap/features/settings/pages/appearance/view.py:64
msgid "Theme"
msgstr "נושא"

#: zapzap/features/initial_setup/view.py:160
#: zapzap/features/settings/pages/appearance/view.py:64
msgid "Choose the visual theme."
msgstr "בחר את הנושא החזותי."

#: zapzap/features/initial_setup/view.py:164
#: zapzap/features/settings/pages/appearance/view.py:66
msgid "Automatic"
msgstr "אוטומטי"

#: zapzap/features/initial_setup/view.py:165
#: zapzap/features/settings/pages/appearance/view.py:67
msgid "Light"
msgstr "בהיר"

#: zapzap/features/initial_setup/view.py:166
#: zapzap/features/settings/pages/appearance/view.py:68
msgid "Dark"
msgstr "כהה"

#: zapzap/features/initial_setup/view.py:183
msgid "Notifications and privacy"
msgstr "התראות ופרטיות"

#: zapzap/features/initial_setup/view.py:184
msgid ""
"Decide how much message information appears in native notification banners."
msgstr "החלט כמה מידע הודעה יופיע בבאנרים של התראות מקוריות."

#: zapzap/features/initial_setup/view.py:188
#: zapzap/features/settings/pages/notifications/view.py:39
msgid "Desktop notifications"
msgstr "הודעות על שולחן העבודה"

#: zapzap/features/initial_setup/view.py:189
msgid "Choose whether ZapZap may show desktop notifications."
msgstr "בחר אם ZapZap עשוי להציג הודעות על שולחן העבודה."

#: zapzap/features/initial_setup/view.py:194
msgid "Enable notifications"
msgstr "אפשר התראות"

#: zapzap/features/initial_setup/view.py:195
msgid ""
"Allow ZapZap to publish native desktop notifications for WhatsApp activity."
msgstr "אפשר ל-ZapZap לפרסם התראות שולחן עבודה מקוריות עבור פעילות WhatsApp."

#: zapzap/features/initial_setup/view.py:203
msgid "Notification privacy"
msgstr "פרטיות הודעות"

#: zapzap/features/initial_setup/view.py:204
msgid "Limit what is visible in notification banners."
msgstr "הגבל את מה שנראה בבאנרים של התראות."

#: zapzap/features/initial_setup/view.py:209
msgid "Show contact photo"
msgstr "הצג תמונת איש קשר"

#: zapzap/features/initial_setup/view.py:210
msgid "Display the sender avatar when it is available."
msgstr "הצג את דמות השולח כאשר הוא זמין."

#: zapzap/features/initial_setup/view.py:213
msgid "Show contact name"
msgstr "הצג את שם איש הקשר"

#: zapzap/features/initial_setup/view.py:214
msgid "Display the sender or group name."
msgstr "הצג את שם השולח או הקבוצה."

#: zapzap/features/initial_setup/view.py:217
msgid "Show message preview"
msgstr "הצגת תצוגה מקדימה של ההודעה"

#: zapzap/features/initial_setup/view.py:218
msgid "Display the message text in the notification."
msgstr "הצג את טקסט ההודעה בהתראה."

#: zapzap/features/initial_setup/view.py:232
msgid "Background behavior"
msgstr "התנהגות רקע"

#: zapzap/features/initial_setup/view.py:233
msgid ""
"Choose whether ZapZap should stay available from the tray and start with "
"your session."
msgstr "בחר אם ZapZap יישאר זמין מהמגש והתחל עם ההפעלה שלך."

#: zapzap/features/initial_setup/view.py:237
#: zapzap/features/settings/pages/appearance/view.py:81
msgid "Tray icon"
msgstr "סמל בשורת המערכת"

#: zapzap/features/initial_setup/view.py:238
msgid "Control tray icon visibility and unread counter."
msgstr "שליטה בנראות סמל המגש ובמונה שלא נקרא."

#: zapzap/features/initial_setup/view.py:243
msgid "Enable tray icon"
msgstr "סמל מגש הפעל"

#: zapzap/features/initial_setup/view.py:244
msgid "Show ZapZap in the system tray."
msgstr "הצג את ZapZap במגש המערכת."

#: zapzap/features/initial_setup/view.py:247
msgid "Notification counter"
msgstr "מונה הודעות"

#: zapzap/features/initial_setup/view.py:248
msgid "Show unread notifications on the tray icon."
msgstr "הצג הודעות שלא נקראו בסמל המגש."

#: zapzap/features/initial_setup/view.py:258
msgid "Window behavior"
msgstr "התנהגות חלונות"

#: zapzap/features/initial_setup/view.py:259
msgid "Configure close behavior."
msgstr "הגדר התנהגות קרובה."

#: zapzap/features/initial_setup/view.py:264
msgid "Keep running in the background"
msgstr "המשיכו לרוץ ברקע"

#: zapzap/features/initial_setup/view.py:265
msgid "Hide the main window instead of quitting when it is closed."
msgstr "הסתר את החלון הראשי במקום לצאת כשהוא סגור."

#: zapzap/features/initial_setup/view.py:268
msgid "Confirm before closing the window"
msgstr "אשר לפני סגירת החלון"

#: zapzap/features/initial_setup/view.py:269
msgid "Ask for confirmation before closing ZapZap."
msgstr "בקש אישור לפני סגירת ZapZap."

#: zapzap/features/initial_setup/view.py:279
#: zapzap/features/settings/pages/system_startup/view.py:40
msgid "Startup"
msgstr "הפעלה"

#: zapzap/features/initial_setup/view.py:280
msgid "Control how ZapZap behaves when your desktop session starts."
msgstr "שלוט בהתנהגות של ZapZap כשההפעלה שלך בשולחן העבודה מתחילה."

#: zapzap/features/initial_setup/view.py:285
#: zapzap/features/settings/pages/system_startup/view.py:45
msgid "Start with the system"
msgstr "הפעלה עם עליית המערכת"

#: zapzap/features/initial_setup/view.py:286
msgid "Create or remove the desktop autostart entry."
msgstr "צור או הסר את ערך ההפעלה האוטומטית של שולחן העבודה."

#: zapzap/features/initial_setup/view.py:289
msgid "Start minimized"
msgstr "התחלה ממוזערת"

#: zapzap/features/initial_setup/view.py:290
msgid "Open ZapZap in the background instead of showing the main window."
msgstr "פתח את ZapZap ברקע במקום להציג את החלון הראשי."

#: zapzap/features/initial_setup/view.py:303
msgid "Downloads and typing"
msgstr "הורדות והקלדה"

#: zapzap/features/initial_setup/view.py:304
msgid ""
"Choose where files are saved and enable spell checking when dictionaries are"
" available."
msgstr "בחר היכן הקבצים נשמרים והפעל בדיקת איות כאשר מילונים זמינים."

#: zapzap/features/initial_setup/view.py:308
#: zapzap/features/settings/pages/language_downloads/view.py:52
msgid "Downloads"
msgstr "הורדות"

#: zapzap/features/initial_setup/view.py:309
#: zapzap/features/settings/pages/language_downloads/view.py:53
msgid "Choose where downloaded files are saved."
msgstr "בחר היכן יישמרו קבצים שהורדו."

#: zapzap/features/initial_setup/view.py:314
#: zapzap/features/settings/pages/language_downloads/view.py:57
msgid "Download directory"
msgstr "הורד ספרייה"

#: zapzap/features/initial_setup/view.py:315
msgid "Set a custom folder or keep the current download location."
msgstr "הגדר תיקיה מותאמת אישית או השאר את מיקום ההורדה הנוכחי."

#: zapzap/features/initial_setup/view.py:316
msgid "Choose folder"
msgstr "בחר תיקיה"

#: zapzap/features/initial_setup/view.py:326
#: zapzap/features/settings/pages/language_downloads/view.py:73
msgid "Spell checker"
msgstr "בודק איות"

#: zapzap/features/initial_setup/view.py:327
#: zapzap/features/settings/pages/language_downloads/view.py:74
msgid "Select compiled dictionaries and where ZapZap should look for them."
msgstr "בחר מילונים מלוקטים והיכן ZapZap צריך לחפש אותם."

#: zapzap/features/initial_setup/view.py:332
#: zapzap/features/settings/pages/language_downloads/view.py:78
msgid "Enable spell checker"
msgstr "הפעל בודק איות"

#: zapzap/features/initial_setup/view.py:333
#: zapzap/features/settings/pages/language_downloads/view.py:79
msgid "Use Qt WebEngine spell checking with the selected dictionary."
msgstr "השתמש בבדיקת איות Qt WebEngine עם המילון שנבחר."

#: zapzap/features/initial_setup/view.py:336
#: zapzap/features/settings/pages/language_downloads/view.py:82
msgid "Dictionary language"
msgstr "שפת מילון"

#: zapzap/features/initial_setup/view.py:337
#: zapzap/features/settings/pages/language_downloads/view.py:83
msgid "Recognizes only compiled dictionaries (.bdic)."
msgstr "מזהה רק מילונים מהודרים (.bdic)."

#: zapzap/features/initial_setup/view.py:341
msgid ""
"No compiled dictionaries were found. You can configure dictionaries later in"
" Settings."
msgstr "לא נמצאו מילונים מלוקטים.תוכל להגדיר מילונים מאוחר יותר בהגדרות."

#: zapzap/features/initial_setup/view.py:356
msgid "Essential permissions"
msgstr "הרשאות חיוניות"

#: zapzap/features/initial_setup/view.py:357
msgid ""
"Allow only the WhatsApp Web permissions you want to grant automatically."
msgstr "אפשר רק את ההרשאות WhatsApp Web שברצונך להעניק אוטומטית."

#: zapzap/features/initial_setup/view.py:362
msgid "When an option is unchecked, ZapZap will ask again in each session."
msgstr "כאשר אפשרות לא מסומנת, ZapZap ישאל שוב בכל הפעלה."

#: zapzap/features/initial_setup/view.py:368
msgid ""
"Enable only the permissions you want to grant automatically when the page "
"requests them."
msgstr "אפשר רק את ההרשאות שברצונך להעניק באופן אוטומטי כאשר הדף מבקש אותן."

#: zapzap/features/initial_setup/view.py:372
#: zapzap/features/settings/pages/permissions/view.py:64
msgid "Microphone"
msgstr "מיקרופון"

#: zapzap/features/initial_setup/view.py:373
#: zapzap/features/settings/pages/permissions/view.py:65
msgid "Automatically allow access to your microphone."
msgstr "אפשר גישה אוטומטית למיקרופון שלך."

#: zapzap/features/initial_setup/view.py:376
#: zapzap/features/settings/pages/permissions/view.py:69
msgid "Camera"
msgstr "מצלמה"

#: zapzap/features/initial_setup/view.py:377
#: zapzap/features/settings/pages/permissions/view.py:70
msgid "Automatically allow access to your camera."
msgstr "אפשר גישה אוטומטית למצלמה שלך."

#: zapzap/features/initial_setup/view.py:380
msgid "Screen contents"
msgstr "תוכן מסך"

#: zapzap/features/initial_setup/view.py:381
#: zapzap/features/settings/pages/permissions/view.py:94
msgid "Automatically allow sharing of screen contents."
msgstr "אפשר שיתוף אוטומטי של תוכן מסך."

#: zapzap/features/initial_setup/view.py:384
msgid "WebRTC shield"
msgstr "מגן WebRTC"

#: zapzap/features/initial_setup/view.py:385
msgid "Reduce WebRTC IP exposure."
msgstr "צמצם את חשיפת ה-IP של WebRTC."

#: zapzap/features/initial_setup/view.py:402
#: zapzap/features/settings/pages/permissions/view.py:130
msgid "Flatpak permissions"
msgstr "הרשאות Flatpak"

#: zapzap/features/initial_setup/view.py:403
#: zapzap/features/settings/pages/permissions/view.py:131
msgid ""
"Grant filesystem access if downloads, imports, or dictionaries cannot reach "
"folders outside the sandbox."
msgstr ""
"הענק גישה למערכת הקבצים אם הורדות, ייבוא או מילונים אינם יכולים להגיע "
"לתיקיות מחוץ לארגז החול."

#: zapzap/features/initial_setup/view.py:409
#: zapzap/features/settings/pages/permissions/view.py:135
msgid ""
"Flatpak sandbox: if file access fails, grant folder permissions using "
"Flatseal or flatpak override."
msgstr ""
"ארגז חול Flatpak: אם הגישה לקובץ נכשלת, הענק הרשאות תיקיה באמצעות Flatseal "
"או Flatpak."

#: zapzap/features/initial_setup/view.py:419
#: zapzap/features/settings/pages/permissions/view.py:143
msgid "Select and copy this command in your terminal"
