#: zapzap/features/settings/pages/performance_experimental/view.py:190
msgid "Smooth scrolling"
msgstr "גלילה חלקה"

#: zapzap/features/settings/pages/performance_experimental/view.py:191
msgid "Disabling may reduce CPU usage."
msgstr "השבתה עשויה להפחית את השימוש במעבד."

#: zapzap/features/settings/pages/performance_experimental/view.py:194
msgid "Background throttling"
msgstr "מצערת רקע"

