#: zapzap/features/settings/pages/performance_experimental/controller.py:205
msgid ""
"Defines where the HTTP cache will be stored.\n"
"Disk: faster after restart.\n"
"Memory: faster, but lost on exit.\n"
"No cache: lower disk usage, slower."
msgstr ""
"מגדיר היכן יאוחסן מטמון ה-HTTP.\n"
"דיסק: מהיר יותר לאחר הפעלה מחדש.\n"
"זיכרון: מהיר יותר, אבל אבוד ביציאה.\n"
"אין מטמון: שימוש נמוך יותר בדיסק, איטי יותר."

#: zapzap/features/settings/pages/performance_experimental/controller.py:213
#, fuzzy, python-brace-format
msgid ""
"Maximum HTTP cache size: {maximum} MiB.\n"
"0 MiB uses Chromium's automatic cache management."
msgstr ""
"גודל מטמון HTTP מקסימלי.\n"
"0 MB משתמש בהתנהגות ברירת המחדל של Chromium."

#: zapzap/features/settings/pages/performance_experimental/controller.py:218
msgid ""
"Keeps cookies between restarts.\n"
"Disabling may cause frequent logouts."
msgstr ""
"שומר עוגיות בין הפעלה מחדש.\n"
"השבתה עלולה לגרום להתנתקות תכופה."

#: zapzap/features/settings/pages/performance_experimental/controller.py:222
msgid ""
"Runs GPU and rendering in the same process.\n"
"May reduce memory usage, but can cause instability."
msgstr ""
"מפעיל את GPU ועיבוד באותו תהליך.\n"
"עשוי להפחית את השימוש בזיכרון, אך עלול לגרום לחוסר יציבות."

#: zapzap/features/settings/pages/performance_experimental/controller.py:228
msgid ""
"Disables GPU hardware acceleration.\n"
"Recommended only for old GPUs or problematic drivers."
msgstr ""
"משבית את האצת החומרה של GPU.\n"
"מומלץ רק עבור GPUs ישנים או מנהלי התקנים בעייתיים."

#: zapzap/features/settings/pages/performance_experimental/controller.py:234
msgid ""
"Automatically honors an unambiguous DRI_PRIME selector on systems with "
"multiple Linux render GPUs. Otherwise, adds --disable-gpu-compositing when "
"one GPU has no connected display.\n"
"\n"
"Disable this only if the automatic workaround causes problems. Restart "
"required."
msgstr ""
"מכבד באופן אוטומטי בורר DRI_PRIME חד משמעי במערכות עם מספר גרפי עיבוד של "
"לינוקס.אחרת, מוסיף --disable-gpu-compositing כאשר ל-GPU אחד אין צג מחובר.\n"
"\n"
"השבת זאת רק אם הפתרון האוטומטי גורם לבעיות.נדרשת הפעלה מחדש."

#: zapzap/features/settings/pages/performance_experimental/controller.py:243
msgid ""
"Disables GPU VSync.\n"
"May reduce latency, but can increase power usage and tearing."
msgstr ""
"משבית את VSync GPU.\n"
"עשוי להפחית את זמן האחזור, אך יכול להגביר את צריכת החשמל והקריעה."

#: zapzap/features/settings/pages/performance_experimental/controller.py:249
msgid ""
"Forces software rendering.\n"
"Use only in case of graphical issues.\n"
"May significantly reduce performance."
msgstr ""
"מאלץ עיבוד תוכנה.\n"
"השתמש רק במקרה של בעיות גרפיות.\n"
"עשוי להפחית משמעותית את הביצועים."

#: zapzap/features/settings/pages/performance_experimental/controller.py:256
msgid ""
"Avoids GPU-backed video frame buffers.\n"
"May help with black screens, flickering, and GPU crashes.\n"
"Restart required."
msgstr ""

#: zapzap/features/settings/pages/performance_experimental/controller.py:263
msgid ""
"Disables zero-copy GPU buffer transfers.\n"
"May improve compatibility with some graphics drivers.\n"
"Restart required."
msgstr ""

#: zapzap/features/settings/pages/performance_experimental/controller.py:270
msgid ""
"Disables hardware video decoding without disabling all GPU acceleration.\n"
"Use when videos play only audio, appear white or black, flicker, or cause "
"crashes.\n"
"May increase CPU and battery usage. Restart required."
msgstr ""
"משבית פענוח וידאו בחומרה מבלי להשבית את כל האצת המעבד הגרפי.\n"
"יש להשתמש כאשר סרטונים משמיעים שמע בלבד, מופיעים בלבן או בשחור, מהבהבים או "
"גורמים לקריסות.\n"
"עשוי להגדיל את השימוש במעבד ובסוללה. נדרשת הפעלה מחדש."

#: zapzap/features/settings/pages/performance_experimental/controller.py:279
msgid ""
"Forces the GBM backend on Wayland.\n"
"Known to fix severe typing lag on NVIDIA drivers."
msgstr ""
"מאלץ את הקצה האחורי של GBM על Wayland.\n"
"ידוע לתקן עיכוב הקלדה חמור במנהלי התקנים של NVIDIA."

#: zapzap/features/settings/pages/performance_experimental/controller.py:285
msgid ""
"Disables the accessibility bus.\n"
"Known to fix typing lag or CPU spikes in QtWebEngine."
msgstr ""
"משבית את אוטובוס הנגישות.\n"
"ידוע לתקן פיגור בהקלדה או עליות מעבד ב-QtWebEngine."

#: zapzap/features/settings/pages/performance_experimental/controller.py:291
msgid ""
"Runs the entire Chromium engine in a single process.\n"
"Reduces memory usage, but may cause crashes.\n"
"Experimental usage."
msgstr ""
"מפעיל את כל מנוע Chromium בתהליך אחד.\n"
"מפחית את השימוש בזיכרון, אך עלול לגרום לקריסות.\n"
"שימוש ניסיוני."

#: zapzap/features/settings/pages/performance_experimental/controller.py:298
msgid ""
"Uses a separate process per site.\n"
"Safer and more stable.\n"
"May increase memory usage."
msgstr ""
"משתמש בתהליך נפרד לכל אתר.\n"
"בטוח יותר ויציב יותר.\n"
"עשוי להגביר את השימוש בזיכרון."

#: zapzap/features/settings/pages/performance_experimental/controller.py:305
msgid ""
"JavaScript (V8) memory limit.\n"
"Automatic is the safest option.\n"
"Higher values allow heavier pages.\n"
"\n"
"Restart required."
msgstr ""
"מגבלת זיכרון JavaScript (V8).\n"
"אוטומטי היא האפשרות הבטוחה ביותר.\n"
"ערכים גבוהים יותר מאפשרים דפים כבדים יותר.\n"
"\n"
"נדרשת הפעלה מחדש."

#: zapzap/features/settings/pages/performance_experimental/controller.py:313
msgid ""
"Enables V8 predictable garbage collection schedule.\n"
"This adds --js-flags=--predictable-gc-schedule and --disable-gpu to "
"QTWEBENGINE_CHROMIUM_FLAGS.\n"
"\n"
"Experimental option. Restart required."
msgstr ""
"מאפשר V8 לוח זמנים לאיסוף אשפה צפוי.\n"
"זה מוסיף --js-flags=--predictable-gc-schedule ו--disable-gpu "
"ל-QTWEBENGINE_CHROMIUM_FLAGS.\n"
"\n"
"אפשרות נסיונית.נדרשת הפעלה מחדש."

#: zapzap/features/settings/pages/performance_experimental/controller.py:320
msgid ""
"Enables smooth scrolling animations.\n"
"Disabling may reduce CPU usage."
msgstr ""
"מאפשר גלילה חלקה של אנימציות.\n"
"השבתה עשויה להפחית את השימוש במעבד."

#: zapzap/features/settings/pages/performance_experimental/controller.py:324
msgid ""
"Allows background tabs to reduce resource usage.\n"
"Disabling keeps timers active, but uses more resources."
msgstr ""
"מאפשר לכרטיסיות רקע להפחית את השימוש במשאבים.\n"
"השבתה שומרת על טיימרים פעילים, אך משתמשת במשאבים רבים יותר."

#: zapzap/features/settings/pages/performance_experimental/controller.py:330
msgid ""
"Disables CSS and JavaScript animations.\n"
"May improve performance on slower machines."
msgstr ""
"משבית את הנפשות CSS ו-JavaScript.\n"
"עשוי לשפר את הביצועים במכונות איטיות יותר."

#: zapzap/features/settings/pages/performance_experimental/controller.py:336
msgid ""
"Disables pinch-to-zoom gesture on touchpads.\n"
"Useful if accidental zooming occurs during scrolling."
msgstr ""
"משבית תנועת צביטה לזום במשטחי מגע.\n"
"שימושי אם מתרחשת התקרבות בשוגג במהלך הגלילה."

#: zapzap/features/settings/pages/performance_experimental/controller.py:342
msgid ""
"Uses Selection.modify() with visual directions for Ctrl+Arrow word "
"navigation.\n"
"This fixes reversed cursor movement in RTL text inside WhatsApp Web message "
"fields.\n"
"\n"
"Restart or reload WhatsApp Web after changing this option."
msgstr ""
"משתמש ב-Selection.modify() עם הנחיות חזותיות עבור ניווט מילים Ctrl+Arrow.\n"
"זה מתקן תנועה הפוכה של הסמן בטקסט RTL בתוך שדות ההודעה WhatsApp Web.\n"
"\n"
"הפעל מחדש או טען מחדש את WhatsApp Web לאחר שינוי אפשרות זו."

#: zapzap/features/settings/pages/performance_experimental/controller.py:348
msgid ""
"Restores all performance settings\n"
"to safe default values."
msgstr ""
"משחזר את כל הגדרות הביצועים\n"
"לערכי ברירת מחדל בטוחים."

#: zapzap/features/settings/pages/performance_experimental/view.py:22
msgid "Tune cache, GPU, processes, and advanced behavior."
msgstr "כוונון מטמון, GPU, תהליכים והתנהגות מתקדמת."

#: zapzap/features/settings/pages/performance_experimental/view.py:40
