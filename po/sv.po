#: zapzap/core/diagnostics/dialog_dump_handler.py:27
msgid "Unexpected Error"
msgstr "Oväntat fel"

#: zapzap/core/diagnostics/dialog_dump_handler.py:28
msgid "The application encountered an unexpected error."
msgstr "Applikationen stötte på ett oväntat fel."

#: zapzap/core/diagnostics/dialog_dump_handler.py:30
#, python-brace-format
msgid ""
"A diagnostic report was generated automatically at:\n"
"\n"
"{path}\n"
"\n"
"Please send this file to support so we can investigate the issue.\n"
"\n"
"Report channels:\n"
" - Issue tracker: {issue_url}\n"
" - Email: {email}"
msgstr ""
"En felrapport genererades automatiskt i:\n"
"\n"
"{path}\n"
"\n"
"Vänligen skicka denna rapport till support så att felet kan undersökas.\n"
"\n"
"Rapportvägar:\n"
" - Ärendesystem: {issue_url}\n"
" - E-post: {email}"

