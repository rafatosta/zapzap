msgstr "Inaktivera VSync"

#: zapzap/features/settings/pages/performance_experimental/view.py:106
msgid "May reduce latency, but can increase tearing."
msgstr "Kan minska latens, men kan öka tearing."

#: zapzap/features/settings/pages/performance_experimental/view.py:109
