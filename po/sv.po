msgstr "Använd endast för grafiska problem."

#: zapzap/features/settings/pages/performance_experimental/view.py:113
msgid "Use software video decoding"
msgstr "Använd programvaruavkodning av video"

#: zapzap/features/settings/pages/performance_experimental/view.py:115
msgid ""
"Disables hardware video decoding to fix videos that appear white, black, "
"flicker, or cause crashes. This may increase CPU and battery usage."
msgstr ""
"Inaktiverar hårdvaruavkodning av video för att åtgärda videor som visas vita "
"eller svarta, flimrar eller orsakar krascher. Detta kan öka processor- och "
"batterianvändningen."

#: zapzap/features/settings/pages/performance_experimental/view.py:121
msgid "Force GBM"
msgstr "Tvinga GBM"

#: zapzap/features/settings/pages/performance_experimental/view.py:122
msgid "Known NVIDIA typing lag fix."
msgstr "Känd NVIDIA skrivfördröjningsfix."

#: zapzap/features/settings/pages/performance_experimental/view.py:125
msgid "Disable accessibility bus"
msgstr "Inaktivera tillgänglighetsbuss"

#: zapzap/features/settings/pages/performance_experimental/view.py:126
msgid "Known typing lag or CPU spike fix in QtWebEngine."
msgstr "Känd fix för skrivfördröjning eller CPU-pick i QtWebEngine."

#: zapzap/features/settings/pages/performance_experimental/view.py:152
msgid "Processes"
msgstr "Processer"

#: zapzap/features/settings/pages/performance_experimental/view.py:153
msgid "Chromium process model options."
msgstr "Chromium-processmodellsalternativ."

#: zapzap/features/settings/pages/performance_experimental/view.py:157
msgid "Single process"
msgstr "Enkel process"

#: zapzap/features/settings/pages/performance_experimental/view.py:158
msgid "Experimental; reduces memory usage but may cause crashes."
msgstr "Experimentell; minskar minnesanvändning men kan orsaka krascher."

#: zapzap/features/settings/pages/performance_experimental/view.py:161
msgid "Process per site"
msgstr "Process per webbplats"

#: zapzap/features/settings/pages/performance_experimental/view.py:162
msgid "Safer and more stable, but may increase memory usage."
msgstr "Säkrare och mer stabilt, men kan öka minnesanvändningen."

#: zapzap/features/settings/pages/performance_experimental/view.py:173
msgid "JavaScript memory"
msgstr "JavaScript minne"

#: zapzap/features/settings/pages/performance_experimental/view.py:174
msgid "V8 memory limit. Restart required."
msgstr "V8 minnesgräns. Omstart krävs."

#: zapzap/features/settings/pages/performance_experimental/view.py:178
msgid "JavaScript memory limit"
msgstr "Minnesgräns för JavaScript"

#: zapzap/features/settings/pages/performance_experimental/view.py:179
msgid "Automatic is the safest option."
msgstr "Automatiskt är det säkraste alternativet."

#: zapzap/features/settings/pages/performance_experimental/view.py:183
msgid "JavaScript GC predictable schedule (experimental)"
msgstr "JavaScript GC förutsägbar schema (experimentell)"

#: zapzap/features/settings/pages/performance_experimental/view.py:184
msgid "Enables predictable V8 garbage collection and disables GPU."
msgstr "Aktiverar förutsägbar V8-skräpinsamling och inaktiverar GPU."

#: zapzap/features/settings/pages/performance_experimental/view.py:195
msgid "Web behavior"
msgstr "Webb-beteende"

#: zapzap/features/settings/pages/performance_experimental/view.py:196
msgid "Behavior options for rendered web content."
msgstr "Grundläggande"

#: zapzap/features/settings/pages/performance_experimental/view.py:200
msgid "Smooth scrolling"
msgstr "Mjuk rullning"

#: zapzap/features/settings/pages/performance_experimental/view.py:201
msgid "Disabling may reduce CPU usage."
msgstr "Inaktivering kan minska CPU-användning."

#: zapzap/features/settings/pages/performance_experimental/view.py:204
msgid "Background throttling"
msgstr "Bakgrundsbeteeende"

#: zapzap/features/settings/pages/performance_experimental/view.py:205
msgid "Allows background tabs to reduce resource usage."
msgstr "Tillåter bakgrundsflikar att minska resursanvändning."

#: zapzap/features/settings/pages/performance_experimental/view.py:208
msgid "Disable animations"
msgstr "Inaktivera animationer"

#: zapzap/features/settings/pages/performance_experimental/view.py:209
msgid "May improve performance on slower machines."
msgstr "Kan förbättra prestanda på långsammare datorer."

#: zapzap/features/settings/pages/performance_experimental/view.py:212
msgid "Disable pinch-to-zoom"
msgstr "Inaktivera nyp-till-zoom"

#: zapzap/features/settings/pages/performance_experimental/view.py:213
msgid "Useful if accidental zooming occurs during scrolling."
msgstr "Användbart om oavsiktlig zoomning sker under scrollning."

#: zapzap/features/settings/pages/performance_experimental/view.py:216
msgid "Fix Ctrl+Arrow cursor movement"
msgstr "Åtgärda Ctrl+Arrow markörrörelse"

#: zapzap/features/settings/pages/performance_experimental/view.py:218
msgid ""
"Use visual word navigation in editable fields to fix RTL text cursor "
"movement."
msgstr ""
"Använd visuell ordnavigering i redigerbara fält för att fixa RTL "
"textmarkörens rörelse."

#: zapzap/features/settings/pages/performance_experimental/view.py:241
msgid "Restore defaults"
msgstr "Återställ till standard"

#: zapzap/features/settings/pages/performance_experimental/view.py:242
msgid "Return performance settings to safe defaults."
msgstr "Återgå prestandainställningar till säkra standardvärden."

#: zapzap/features/settings/pages/performance_experimental/view.py:246
msgid "Restore performance defaults"
msgstr "Återställ prestanda till standardvärden"

#: zapzap/features/settings/pages/performance_experimental/view.py:247
msgid "Restores all performance settings to safe default values."
msgstr "Återställer alla prestanda-inställningar till säkra standardvärden."

#: zapzap/features/settings/pages/performance_experimental/controller.py:139
msgid ""
"Defines where the HTTP cache will be stored.\n"
"Disk: faster after restart.\n"
"Memory: faster, but lost on exit.\n"
"No cache: lower disk usage, slower."
msgstr ""
"Bestämmer var HTTP-cachen lagras.\n"
"Disk: Snabbare efter omstart.\n"
"Minne (Memory): Snabbare, men förloras vid programavslut\n"
"Ingen cache (No Cache): Lägre diskanvändning, långsammare."

#: zapzap/features/settings/pages/performance_experimental/controller.py:146
msgid ""
"Maximum HTTP cache size.\n"
"0 MB uses the default Chromium behavior."
msgstr ""
"Maximal storlek på HTTP-cache.\n"
"0 MB är standardbeteende för Chromium."

#: zapzap/features/settings/pages/performance_experimental/controller.py:149
msgid ""
"Keeps cookies between restarts.\n"
"Disabling may cause frequent logouts."
msgstr ""
"Behåller cookies mellan omstarter.\n"
"Inaktivering kan orsaka frekventa utloggningar."

#: zapzap/features/settings/pages/performance_experimental/controller.py:153
msgid ""
"Runs GPU and rendering in the same process.\n"
"May reduce memory usage, but can cause instability."
msgstr ""
"Kör grafik och rendering i samma process.\n"
"Kan reducera minnesanvändning, men kan orsaka instabilitet."

#: zapzap/features/settings/pages/performance_experimental/controller.py:159
msgid ""
"Disables GPU hardware acceleration.\n"
"Recommended only for old GPUs or problematic drivers."
msgstr ""
"Inaktiverar hårdvaruaccelerering av grafik.\n"
"Rekommenderas endast för gamla grafikkort eller struliga drivrutiner."

#: zapzap/features/settings/pages/performance_experimental/controller.py:165
msgid ""
"Automatically honors an unambiguous DRI_PRIME selector on systems with "
"multiple Linux render GPUs. Otherwise, adds --disable-gpu-compositing when "
"one GPU has no connected display.\n"
"\n"
"Disable this only if the automatic workaround causes problems. Restart "
"required."
msgstr ""
"Automatiskt hedrar en entydig DRI_PRIME-väljare på system med flera Linux-"
"render-GPU:er. Annars läggs --disable-gpu-compositing till när en GPU inte "
"har någon ansluten skärm.\n"
"\n"
"Inaktivera detta endast om den automatiska lösningen orsakar problem. "
"Omstart krävs."

#: zapzap/features/settings/pages/performance_experimental/controller.py:174
msgid ""
"Disables GPU VSync.\n"
"May reduce latency, but can increase power usage and tearing."
msgstr ""
"Inaktiverar VSync för grafik.\n"
"Kan reducera latens, men kan öka energianvändning och tearing."

#: zapzap/features/settings/pages/performance_experimental/controller.py:180
msgid ""
"Forces software rendering.\n"
"Use only in case of graphical issues.\n"
"May significantly reduce performance."
msgstr ""
"Framtvingar mjukvarurendering.\n"
"Använd endast vid problem med grafik.\n"
"Kan ha stor påverkan på prestanda."

#: zapzap/features/settings/pages/performance_experimental/controller.py:187
msgid ""
"Disables hardware video decoding without disabling all GPU acceleration.\n"
"Use when videos play only audio, appear white or black, flicker, or cause "
"crashes.\n"
"May increase CPU and battery usage. Restart required."
msgstr ""
"Inaktiverar hårdvaruavkodning av video utan att stänga av all GPU-"
"acceleration.\n"
"Använd när videor bara spelar upp ljud, visas vita eller svarta, flimrar "
"eller orsakar krascher.\n"
"Kan öka processor- och batterianvändningen. Omstart krävs."

#: zapzap/features/settings/pages/performance_experimental/controller.py:196
msgid ""
"Forces the GBM backend on Wayland.\n"
"Known to fix severe typing lag on NVIDIA drivers."
msgstr ""
"Tvingar GBM-backend på Wayland.\n"
"Känt för att åtgärda allvarlig skrivfördröjning på NVIDIA-drivrutiner."

#: zapzap/features/settings/pages/performance_experimental/controller.py:202
msgid ""
"Disables the accessibility bus.\n"
"Known to fix typing lag or CPU spikes in QtWebEngine."
msgstr ""
"Inaktiverar tillgänglighetsbussen.\n"
"Känd för att fixa tangentbordsfördröjning eller CPU-spikar i QtWebEngine."

#: zapzap/features/settings/pages/performance_experimental/controller.py:208
msgid ""
"Runs the entire Chromium engine in a single process.\n"
"Reduces memory usage, but may cause crashes.\n"
"Experimental usage."
msgstr ""
"Kör hela Chromium-motorn i en enda process.\n"
"Reducerar minnesanvändning, men kan orsaka krascher.\n"
"Experimentell användning."

#: zapzap/features/settings/pages/performance_experimental/controller.py:215
msgid ""
"Uses a separate process per site.\n"
"Safer and more stable.\n"
"May increase memory usage."
msgstr ""
"Använd en separat process per sajt.\n"
"Säkrare och mer stabilt.\n"
"Kan öka minnesanvändningen."

#: zapzap/features/settings/pages/performance_experimental/controller.py:222
msgid ""
"JavaScript (V8) memory limit.\n"
"Automatic is the safest option.\n"
"Higher values allow heavier pages.\n"
"\n"
"Restart required."
msgstr ""
"Minnesgräns för JavaScript (V8).\n"
"Automatiskt är det säkraste valet.\n"
"Högre värden tillåter tyngre sidor.\n"
"\n"
"Omstart krävs."

#: zapzap/features/settings/pages/performance_experimental/controller.py:230
msgid ""
"Enables V8 predictable garbage collection schedule.\n"
"This adds --js-flags=--predictable-gc-schedule and --disable-gpu to "
"QTWEBENGINE_CHROMIUM_FLAGS.\n"
"\n"
"Experimental option. Restart required."
msgstr ""
"Aktiverar V8:s förutsägbara skräpsamlingsschema.\n"
"Detta lägger till --js-flags=--predictable-gc-schedule och --disable-gpu "
"till QTWEBENGINE_CHROMIUM_FLAGS.\n"
"\n"
"Experimentellt alternativ. Omstart krävs."

#: zapzap/features/settings/pages/performance_experimental/controller.py:237
msgid ""
"Enables smooth scrolling animations.\n"
"Disabling may reduce CPU usage."
msgstr ""
"Aktiverar mjuka rullningsanimationer.\n"
"Inaktivering kan reducera processoranvändning."

#: zapzap/features/settings/pages/performance_experimental/controller.py:241
msgid ""
"Allows background tabs to reduce resource usage.\n"
"Disabling keeps timers active, but uses more resources."
msgstr ""
"Tillåter bakgrundsflikar för att reducera resursanvändning.\n"
"Inaktivering behåller timers aktiva, men använder mer resurser."

#: zapzap/features/settings/pages/performance_experimental/controller.py:247
msgid ""
"Disables CSS and JavaScript animations.\n"
"May improve performance on slower machines."
msgstr ""
"Inaktiverar CSS- och JavaScript-animationer.\n"
"Kan förbättra prestandan på långsamma enheter."

#: zapzap/features/settings/pages/performance_experimental/controller.py:253
msgid ""
"Disables pinch-to-zoom gesture on touchpads.\n"
"Useful if accidental zooming occurs during scrolling."
msgstr ""
"Inaktiverar nyp-till-zoom-gest på pekplattor.\n"
"Användbart om oavsiktlig zoomning sker under rullning."

#: zapzap/features/settings/pages/performance_experimental/controller.py:259
msgid ""
"Uses Selection.modify() with visual directions for Ctrl+Arrow word "
"navigation.\n"
"This fixes reversed cursor movement in RTL text inside WhatsApp Web message "
"fields.\n"
"\n"
"Restart or reload WhatsApp Web after changing this option."
msgstr ""
"Använder Selection.modify() med visuella riktningar för Ctrl+Arrow "
"ordnavigering.\n"
"Detta åtgärdar omvänd markörförflyttning i RTL text inuti WhatsApp Web "
"meddelandefält.\n"
"\n"
"Starta om eller ladda om WhatsApp Web efter att ha ändrat detta alternativ."

#: zapzap/features/settings/pages/performance_experimental/controller.py:265
msgid ""
"Restores all performance settings\n"
"to safe default values."
msgstr ""
"Återställer alla prestandainställningar\n"
"till säkra standardvärden."

#: zapzap/features/settings/pages/permissions/view.py:23
msgid "Define which permissions can be granted automatically to WhatsApp Web."
