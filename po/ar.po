msgstr "اختر مكان حفظ الملفات التي تم تنزيلها."

#: zapzap/features/initial_setup/view.py:336
#: zapzap/features/settings/pages/language_downloads/view.py:57
msgid "Download directory"
msgstr "تحميل الدليل"

#: zapzap/features/initial_setup/view.py:337
msgid "Set a custom folder or keep the current download location."
msgstr "قم بتعيين مجلد مخصص أو احتفظ بموقع التنزيل الحالي."

#: zapzap/features/initial_setup/view.py:338
msgid "Choose folder"
msgstr "اختر المجلد"

#: zapzap/features/initial_setup/view.py:348
#: zapzap/features/settings/pages/language_downloads/view.py:73
msgid "Spell checker"
msgstr "المدقق الإملائي"

#: zapzap/features/initial_setup/view.py:349
#: zapzap/features/settings/pages/language_downloads/view.py:74
msgid "Select compiled dictionaries and where ZapZap should look for them."
msgstr "حدد القواميس المجمعة وأين يجب أن يبحث عنها ZapZap."

#: zapzap/features/initial_setup/view.py:354
#: zapzap/features/settings/pages/language_downloads/view.py:78
msgid "Enable spell checker"
msgstr "تمكين المدقق الإملائي"

#: zapzap/features/initial_setup/view.py:355
#: zapzap/features/settings/pages/language_downloads/view.py:79
msgid "Use Qt WebEngine spell checking with the selected dictionary."
msgstr "استخدم التدقيق الإملائي Qt WebEngine مع القاموس المحدد."

#: zapzap/features/initial_setup/view.py:358
#: zapzap/features/settings/pages/language_downloads/view.py:82
msgid "Dictionary language"
msgstr "لغة القاموس"

#: zapzap/features/initial_setup/view.py:359
#: zapzap/features/settings/pages/language_downloads/view.py:83
msgid "Recognizes only compiled dictionaries (.bdic)."
msgstr "يتعرف فقط على القواميس المجمعة (.bdic)."

#: zapzap/features/initial_setup/view.py:373
msgid "Essential permissions"
msgstr "الأذونات الأساسية"

#: zapzap/features/initial_setup/view.py:374
msgid ""
"Allow only the WhatsApp Web permissions you want to grant automatically."
msgstr "السماح فقط بأذونات WhatsApp Web التي تريد منحها تلقائيًا."

#: zapzap/features/initial_setup/view.py:379
msgid "When an option is unchecked, ZapZap will ask again in each session."
msgstr "عند إلغاء تحديد أحد الخيارات، سيطلب ZapZap مرة أخرى في كل جلسة."

#: zapzap/features/initial_setup/view.py:385
msgid ""
"Enable only the permissions you want to grant automatically when the page "
"requests them."
msgstr "قم بتمكين الأذونات التي تريد منحها تلقائيًا فقط عندما تطلبها الصفحة."

#: zapzap/features/initial_setup/view.py:389
#: zapzap/features/settings/pages/permissions/view.py:64
msgid "Microphone"
msgstr "ميكروفون"

#: zapzap/features/initial_setup/view.py:390
#: zapzap/features/settings/pages/permissions/view.py:65
msgid "Automatically allow access to your microphone."
msgstr "السماح تلقائيًا بالوصول إلى الميكروفون الخاص بك."

#: zapzap/features/initial_setup/view.py:393
#: zapzap/features/settings/pages/permissions/view.py:69
msgid "Camera"
msgstr "الكاميرا"

#: zapzap/features/initial_setup/view.py:394
#: zapzap/features/settings/pages/permissions/view.py:70
msgid "Automatically allow access to your camera."
msgstr "السماح تلقائيا بالوصول إلى الكاميرا الخاصة بك."

#: zapzap/features/initial_setup/view.py:397
#: zapzap/features/settings/pages/permissions/view.py:74
msgid "Camera and microphone"
msgstr "الكاميرا والميكروفون"

#: zapzap/features/initial_setup/view.py:398
#: zapzap/features/settings/pages/permissions/view.py:76
msgid "Automatically allow simultaneous access to the camera and microphone."
msgstr "السماح تلقائيًا بالوصول المتزامن إلى الكاميرا والميكروفون."

#: zapzap/features/initial_setup/view.py:401
#: zapzap/features/settings/pages/permissions/view.py:93
msgid "Screen sharing"
msgstr "مشاركة الشاشة"

#: zapzap/features/initial_setup/view.py:402
#: zapzap/features/settings/pages/permissions/view.py:94
msgid "Automatically allow sharing of screen contents."
msgstr "السماح بمشاركة محتويات الشاشة تلقائيًا."

#: zapzap/features/initial_setup/view.py:405
#: zapzap/features/settings/pages/permissions/view.py:98
