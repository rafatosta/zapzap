msgstr "JavaScript GC-vorhersehbarer Zeitplan (experimentell)"

#: zapzap/features/settings/pages/performance_experimental/view.py:184
msgid "Enables predictable V8 garbage collection and disables GPU."
msgstr "Aktiviert die vorhersehbare V8-Garbage Collection und deaktiviert GPU."

#: zapzap/features/settings/pages/performance_experimental/view.py:195
msgid "Web behavior"
msgstr "Webverhalten"

#: zapzap/features/settings/pages/performance_experimental/view.py:196
