msgstr "Verhaltensoptionen für gerenderte Webinhalte."

#: zapzap/features/settings/pages/performance_experimental/view.py:200
msgid "Smooth scrolling"
msgstr "Reibungsloses Scrollen"

#: zapzap/features/settings/pages/performance_experimental/view.py:201
msgid "Disabling may reduce CPU usage."
msgstr "Durch die Deaktivierung kann sich die CPU-Auslastung verringern."

#: zapzap/features/settings/pages/performance_experimental/view.py:204
msgid "Background throttling"
msgstr "Hintergrunddrosselung"

#: zapzap/features/settings/pages/performance_experimental/view.py:205
msgid "Allows background tabs to reduce resource usage."
msgstr ""
"Ermöglicht Hintergrundregisterkarten, um den Ressourcenverbrauch zu "
"reduzieren."

#: zapzap/features/settings/pages/performance_experimental/view.py:208
msgid "Disable animations"
msgstr "Animationen deaktivieren"

#: zapzap/features/settings/pages/performance_experimental/view.py:209
msgid "May improve performance on slower machines."
msgstr "Kann die Leistung auf langsameren Maschinen verbessern."

#: zapzap/features/settings/pages/performance_experimental/view.py:212
msgid "Disable pinch-to-zoom"
msgstr "Pinch-to-Zoom deaktivieren"

#: zapzap/features/settings/pages/performance_experimental/view.py:213
msgid "Useful if accidental zooming occurs during scrolling."
msgstr "Nützlich, wenn beim Scrollen versehentlich gezoomt wird."

#: zapzap/features/settings/pages/performance_experimental/view.py:216
msgid "Fix Ctrl+Arrow cursor movement"
msgstr "Korrigieren Sie die Cursorbewegung Ctrl+Arrow"

#: zapzap/features/settings/pages/performance_experimental/view.py:218
msgid ""
"Use visual word navigation in editable fields to fix RTL text cursor "
